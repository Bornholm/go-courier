{{ define "index" }}
<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>GoCourier</title>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bulma@1.0.4/css/bulma.min.css"
    />
    <script
      src="https://unpkg.com/htmx.org@2.0.4"
      integrity="sha384-HGfztofotfshcF7+8n44JQL2oJmowVChPTg48S+jvZoztPfvwD79OC/LTtG6dMp+"
      crossorigin="anonymous"
    ></script>
    <script
      src="https://unpkg.com/htmx-ext-sse@2.2.3"
      integrity="sha384-Y4gc0CK6Kg+hmulDc6rZPJu0tqvk7EWlih0Oh+2OkAi1ZDlCbBDCQEE2uVk472Ky"
      crossorigin="anonymous"
    ></script>
  </head>
  <body>
    <section class="section">
      <div class="container">
        <h1 class="title">Chat</h1>
        <div
          id="chat-window"
          style="height: 600px; overflow-y: auto; scroll-behavior: smooth"
          class="px-5 py-2"
          hx-ext="sse"
          sse-connect="/messages"
          sse-swap="message"
          hx-swap="beforeend"
          hx-on:htmx:after-swap="this.scrollTo(0, this.scrollHeight)"
        ></div>

        <form
          id="chat-form"
          class="px-5"
          hx-post="/send"
          hx-swap="none"
          hx-on:htmx:after-request="this.reset()"
        >
          <div class="field has-addons">
            <div class="control is-expanded">
              <input
                class="input"
                type="text"
                name="message"
                placeholder="Tapez votre message…"
                required
                autofocus
              />
            </div>
            <div class="control">
              <button class="button is-primary">Envoyer</button>
            </div>
          </div>
        </form>
      </div>
    </section>
  </body>
</html>
{{ end }}
